# Copy to frontend/.env.local if you need to change these.

# Base URL of the API as seen by the browser. Leave empty when the site and
# API share an origin (Vite dev proxy locally; nginx in production).
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api and /media (development only).
VITE_DEV_API_PROXY=http://127.0.0.1:8000
