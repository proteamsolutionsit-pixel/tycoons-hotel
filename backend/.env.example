# Copy to backend/.env and fill in. backend/.env is git-ignored.
# One KEY=value per line. Put comments on their own lines: systemd's
# EnvironmentFile does NOT strip trailing "# comments" from values.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database -----------------------------------------------------------------
# Runtime account: DML only (scripts/mysql-grant-app-user.ps1 creates it).
# pragma: allowlist nextline secret
DATABASE_URL=mysql+pymysql://tycoons_app:CHANGE_ME@127.0.0.1:3308/tycoons?charset=utf8mb4
# Schema owner, used only by Alembic migrations.
# pragma: allowlist nextline secret
MIGRATION_DATABASE_URL=mysql+pymysql://tycoons:CHANGE_ME@127.0.0.1:3308/tycoons?charset=utf8mb4
# Used by pytest only. Its tables are dropped and recreated.
# pragma: allowlist nextline secret
TEST_DATABASE_URL=mysql+pymysql://tycoons:CHANGE_ME@127.0.0.1:3308/tycoons_test?charset=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
# Path to the CA bundle to require TLS to MySQL (recommended when the DB is on another host).
DATABASE_SSL_CA=

# --- HTTP -----------------------------------------------------------------------
# Browser origins allowed to call the API with credentials (comma-separated, never *).
CORS_ORIGINS=http://localhost:5173
# Host headers the API answers to (comma-separated). Production: your domain(s).
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Public site URL, used in emailed links (password reset). Production: https://...
PUBLIC_BASE_URL=http://localhost:5173

# --- Staff sessions --------------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Must be true in production (HTTPS).
COOKIE_SECURE=false
PASSWORD_RESET_MINUTES=30

# --- Razorpay --------------------------------------------------------------------
# Dashboard > Account & Settings > API Keys (test keys start rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks: the secret you set on the webhook
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# --- Hotel rules -----------------------------------------------------------------
HOTEL_TIMEZONE=Asia/Kolkata
BOOKING_HOLD_MINUTES=15
MAX_STAY_NIGHTS=30
MAX_ADVANCE_DAYS=365

# --- Files -------------------------------------------------------------------------
# Uploaded images (public, served at /media) and CVs (private) live here.
STORAGE_DIR=storage

# --- Mail (optional; without SMTP_HOST mail is written to the log instead) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=The Tycoons Hotel <no-reply@example.com>
# New bookings and guest requests are notified here
HOTEL_NOTIFY_EMAIL=

# --- Rate limiting -------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# database = shared across workers/hosts (required in production); memory = per process
RATE_LIMIT_BACKEND=database

# Serve frontend/dist from FastAPI (optional; nginx can do it instead)
# FRONTEND_DIST=../frontend/dist
