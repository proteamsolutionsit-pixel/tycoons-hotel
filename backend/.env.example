# Copy to backend/.env and fill in. backend/.env is git-ignored.
# scripts/mysql-init.ps1 writes DATABASE_URL / TEST_DATABASE_URL for you.

ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=mysql+pymysql://tycoons:CHANGE_ME@127.0.0.1:3308/tycoons?charset=utf8mb4
# Used by pytest only. Tables in this database are dropped and recreated.
TEST_DATABASE_URL=mysql+pymysql://tycoons:CHANGE_ME@127.0.0.1:3308/tycoons_test?charset=utf8mb4

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Admin session signing key: 32+ random characters (required in production).
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false                # must be true in production (HTTPS)

# Razorpay - Dashboard > Account & Settings > API Keys (Test Mode keys start rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks: the secret you set on the webhook
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

HOTEL_TIMEZONE=Asia/Kolkata
BOOKING_HOLD_MINUTES=15
MAX_STAY_NIGHTS=30
MAX_ADVANCE_DAYS=365

# Uploaded images (public, served at /media) and CVs (private) live here.
STORAGE_DIR=storage

# Optional SMTP. Without SMTP_HOST, outgoing mail is written to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=The Tycoons Hotel <no-reply@example.com>
# Where new bookings / enquiries are notified
HOTEL_NOTIFY_EMAIL=

# Serve frontend/dist from FastAPI (optional; nginx can do it instead)
# FRONTEND_DIST=../frontend/dist
